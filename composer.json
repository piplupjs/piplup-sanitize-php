{
  "name": "piplup/sanitize-utils",
  "description": "WordPress-like sanitization and escaping utilities for PHP — framework-agnostic, secure by design.",
  "type": "library",
  "license": "MIT",
  "keywords": ["sanitize", "escape", "xss", "security", "html", "kses"],
  "require": {
    "php": "^8.1",
    "ext-mbstring": "*"
  },
  "suggest": {
    "ext-intl": "Better transliteration support in removeAccents()"
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Piplup\\Sanitize\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Piplup\\Sanitize\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
